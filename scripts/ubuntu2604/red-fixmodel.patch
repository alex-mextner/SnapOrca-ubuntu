-    _EpicMesh oriented;
-    for (size_t i = 0; i < shells.size(); ++i) {
-        if (depth[i] % 2 == 1)
-            PMP::reverse_face_orientations(shells[i]);
-        CGAL::copy_face_graph(shells[i], oriented);
-    }
-    cgal_mesh = std::move(oriented);
-}
